# Database — PostgreSQL
# Local (installed at C:\Users\mohan\pgsql): postgresql://muhanad:PASSWORD@localhost:5432/muhanad_portfolio?schema=public
# Cloud options: Neon / Supabase (free tiers), or `docker compose up -d` from this repo
DATABASE_URL="postgresql://muhanad:muhanad_secret@localhost:5432/muhanad_portfolio?schema=public"

# Admin credentials (REAL — keep private; applied by npm run db:seed)
ADMIN_EMAIL="mohannadwael1000@gmail.com"
ADMIN_PASSWORD="change-me-to-something-strong"
ADMIN_NAME="Muhanad Wael Mahdy"

# Auth — must be a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Public site URL (used for SEO metadata)
NEXT_PUBLIC_SITE_URL="https://arccy1.github.io/muhanad-portfolio"
 
# Email notifications on new contact messages - fill in to activate 

# Email notifications on new contact messages (Gmail: enable 2-step
# verification, create an App Password at myaccount.google.com/apppasswords
# then fill these in - the notification activates automatically)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
NOTIFY_EMAIL=
